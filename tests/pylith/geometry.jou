reset
cd "/home/hintont/projects/pylith-test"
${Units('si')}

# parameters
#{space_x = 150.0*km}
#{space_y = 150.0*km}
#{space_z = 150.0*km}
#{dz_width = 5.0*km}
#{fault_depth = 15.0*km}
#{fault_length = 45.0*km}

# create volume
brick x {space_x} y {space_y} z {space_z}
volume 1 move z {-space_z/2}

# create damage zone
brick x {dz_width} y {fault_length+2*dz_width} z {fault_depth+dz_width}
volume 2 move z {-(fault_depth+dz_width)/2}

# clean up volumes
chop volume 1 with volume 2 keep
delete volume 1 3
volume 2 rename "dz"
volume 4 rename "litho"

# create fault
brick x {1.0} y {fault_length} z {fault_depth}
volume 5 move z {-fault_depth/2}
create planar surface with plane xplane
chop surface 36 with volume 5
delete body 8
surface 37 rename "fault"

# chop damage zone using fault
webcut volume 2 with sheet extended from fault

# export base geometry
export acis "base_geom.sat"  overwrite 