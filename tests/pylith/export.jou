###   CREATE BLOCKS FOR DIFFERENT MATERIALS (name will be used in PyLith)  ###

# homogeneous lithosphere
block 1 volume 2
block 1 name "lithosphere"

# damage zone
block 2 volume 1 4
block 2 name "damage_zone"


###   GROUP NODESETS TOGETHER FOR USE IN PYLITH   ###

# fault
nodeset 1 add node in fault
nodeset 1 name "fault_nodes"

# fault buried edge (bottom and sides)
nodeset 2 add node in curve 37 38 39
nodeset 2 name "buried_edge"


## BOUNDARIES ##

# +x
group "boundary_xpos" add node in surface 12
nodeset 80 group boundary_xpos
nodeset 80 name "boundary_xpos"

# -x
group "boundary_xneg" add node in surface 14
nodeset 81 group boundary_xneg
nodeset 81 name "boundary_xneg"

# -y
group "boundary_yneg" add node in surface 15
nodeset 84 group boundary_yneg
nodeset 84 name "boundary_yneg"


# +y
group "boundary_ypos" add node in surface 13
nodeset 87 group boundary_ypos
nodeset 87 name "boundary_ypos"


# -z
group "boundary_zneg" add node in surface 16
nodeset 90 group boundary_zneg
nodeset 90 name "boundary_zneg"

# +z
group "boundary_zpos" add node in surface 17
nodeset 91 group boundary_zpos
nodeset 91 name "boundary_zpos"

# origin
nodeset 200 add node 1144  # the node at intersection of xneg, yneg, zneg planes
nodeset 200 name "origin"

group "boundary_xpos_nobound" add node in group boundary_xpos
group "boundary_xpos_nobound" remove node in group boundary_ypos
group "boundary_xpos_nobound" remove node in group boundary_yneg
group "boundary_xpos_nobound" remove node in group boundary_zpos
group "boundary_xpos_nobound" remove node in group boundary_zneg
nodeset 93 group boundary_xpos_nobound
nodeset 93 name "boundary_xpos_nobound"

group "boundary_xneg_nobound" add node in group boundary_xneg
group "boundary_xneg_nobound" remove node in group boundary_ypos
group "boundary_xneg_nobound" remove node in group boundary_yneg
group "boundary_xneg_nobound" remove node in group boundary_zpos
group "boundary_xneg_nobound" remove node in group boundary_zneg
nodeset 94 group boundary_xneg_nobound
nodeset 94 name "boundary_xneg_nobound"

group "boundary_ypos_nobound" add node in group boundary_ypos
group "boundary_ypos_nobound" remove node in group boundary_xpos
group "boundary_ypos_nobound" remove node in group boundary_xneg
group "boundary_ypos_nobound" remove node in group boundary_zpos
group "boundary_ypos_nobound" remove node in group boundary_zneg
nodeset 95 group boundary_ypos_nobound
nodeset 95 name "boundary_ypos_nobound"

group "boundary_yneg_nobound" add node in group boundary_yneg
group "boundary_yneg_nobound" remove node in group boundary_xpos
group "boundary_yneg_nobound" remove node in group boundary_xneg
group "boundary_yneg_nobound" remove node in group boundary_zpos
group "boundary_yneg_nobound" remove node in group boundary_zneg
nodeset 96 group boundary_yneg_nobound
nodeset 96 name "boundary_yneg_nobound"


###   EXPORT   ###
export mesh "mesh.exo" dimension 3 overwrite
# block 3 add node in boundary_ypos
# export mesh "surface.exo" dimension 3 block 3 overwrite
# block 4 add node in fault_nodes
# export mesh "fault.exo" dimension 3 block 4 overwrite
# block 5 add node in buried_edge
# export mesh "fault_buried_edge.exo" dimension 3 block 5 overwrite